{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rijin-goals-reminders",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rijin-goals",
      "database_id": "d824537a-4071-4439-abeb-6bf154d4ed31"
    }
  ],
  "vars": { "VAPID_SUBJECT": "https://rijin-goals.pages.dev" }
}
